FROM node:22-alpine AS build

WORKDIR /app
ARG NEXT_PUBLIC_BAIDU_ANALYTICS_ID
ENV NEXT_PUBLIC_BAIDU_ANALYTICS_ID=${NEXT_PUBLIC_BAIDU_ANALYTICS_ID}
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/public ./public
COPY --from=build /app/scripts/static-server.mjs ./scripts/static-server.mjs

EXPOSE 3000
CMD ["./node_modules/.bin/vinext", "start", "--port", "3000", "--hostname", "0.0.0.0"]
